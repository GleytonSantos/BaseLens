# Maintainer: Gleyton Santos <gleyton.santos@estantemagica.com.br>
#
# AUR package that installs the prebuilt release (no Rust toolchain needed).
# scripts/update-channels.sh <version> fills pkgver and the checksum.
pkgname=baselens-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='See into every database: a free, private desktop editor for SQLite, PostgreSQL and MySQL (prebuilt)'
arch=('x86_64')
url='https://github.com/GleytonSantos/BaseLens'
license=('MIT')
depends=('gcc-libs' 'glibc' 'openssl' 'libxkbcommon' 'libglvnd' 'hicolor-icon-theme')
optdepends=('openssh: SSH tunnels to databases behind a bastion'
            'ollama: local AI assistant')
provides=('baselens')
conflicts=('baselens')
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/baselens-$pkgver-linux-x86_64.tar.gz")
sha256sums=('610bc3c482ba6b5014b1a0aa008e08116cee4de6bd4f9117ee4965bfe71c9e72')

package() {
    cd "baselens-$pkgver-linux-x86_64"
    install -Dm755 baselens "$pkgdir/usr/bin/baselens"
    install -Dm644 assets/baselens.desktop "$pkgdir/usr/share/applications/baselens.desktop"
    install -Dm644 assets/baselens.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/baselens.svg"
    for n in 16 24 32 48 64 128 256 512; do
        if [ -f "assets/baselens-$n.png" ]; then
            install -Dm644 "assets/baselens-$n.png" "$pkgdir/usr/share/icons/hicolor/${n}x${n}/apps/baselens.png"
        fi
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
